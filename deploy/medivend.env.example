# Copy to /etc/medivend/medivend.env, owned by root:medivend, mode 0640.
# Examples only; replace the password locally. Never commit the real file.
MEDIVEND_MODE=hardware
MEDIVEND_DB_HOST=localhost
MEDIVEND_DB_PORT=3306
MEDIVEND_DB_NAME=medivend_db
MEDIVEND_DB_USER=medivend_app
MEDIVEND_DB_PASSWORD="REPLACE_WITH_A_LOCAL_SECRET"
# Leave unconfigured until specifications and physical acceptance tests exist.
MEDIVEND_HARDWARE_ADAPTER=""
MEDIVEND_DELIVERY_TIMEOUT_SECONDS=0
MEDIVEND_WORKER_LOCK=/run/medivend/worker.lock
